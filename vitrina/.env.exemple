# Vitrina — variables d'environnement. Copier en .env (jamais commité).

VITRINA_ADMIN_KEY=change-moi
VITRINA_BASE_URL=https://vitrina.nebula-agency.online

# Compte Mobile Money montré à la cliente
MOMO_NAME=
MOMO_NUMBER=
MOMO_NETWORK=

# --- ALERTES ---
# WhatsApp (Meta Cloud API, gratuit, même mécanique que boutique-ia).
# Sans ces variables, WhatsApp dort et Telegram prend seul le relais.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
MONGAZI_WHATSAPP=229XXXXXXXX

# Hors de la fenêtre de 24 h, WhatsApp exige un modèle approuvé par Meta.
# Le laisser vide tant qu'aucun modèle n'est approuvé : l'envoi se fera en
# texte libre et échouera silencieusement hors fenêtre, Telegram assurant.
# Le modèle doit contenir exactement une variable {{1}}.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr

# Telegram : le rail de secours, sans limite de fenêtre. À garder.
TG_TOKEN=
TG_CHAT=
