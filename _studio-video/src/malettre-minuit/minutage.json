{
 "duree": 56.345,
 "minuit": 14.03,
 "debutNarratrice": 21.69,
 "lignes": [
  {
   "id": "k1",
   "voix": "koffi",
   "texte": "Dans trois secondes…",
   "debut": 0.45,
   "fin": 1.49
  },
  {
   "id": "k2",
   "voix": "koffi",
   "texte": "ma mère va pleurer.",
   "debut": 1.87,
   "fin": 2.81
  },
  {
   "id": "k3",
   "voix": "koffi",
   "texte": "Elle a soixante ans ce soir.",
   "debut": 3.36,
   "fin": 4.72
  },
  {
   "id": "k4",
   "voix": "koffi",
   "texte": "Moi…",
   "debut": 4.94,
   "fin": 6.1
  },
  {
   "id": "k5",
   "voix": "koffi",
   "texte": "je suis à Paris.",
   "debut": 6.2,
   "fin": 6.98
  },
  {
   "id": "k6",
   "voix": "koffi",
   "texte": "Alors je lui ai écrit une lettre…",
   "debut": 7.36,
   "fin": 8.98
  },
  {
   "id": "k7",
   "voix": "koffi",
   "texte": "qui ne s'ouvre qu'à minuit pile.",
   "debut": 9.24,
   "fin": 10.98
  },
  {
   "id": "k8",
   "voix": "koffi",
   "texte": "Maman…",
   "debut": 17.18,
   "fin": 17.72
  },
  {
   "id": "k9",
   "voix": "koffi",
   "texte": "tu me réveillais à cinq heures… pour réviser le bac…",
   "debut": 18.0,
   "fin": 21.14
  },
  {
   "id": "a1",
   "voix": "alimata",
   "texte": "Ça, c'est Ma lettre à…",
   "debut": 21.69,
   "fin": 23.335
  },
  {
   "id": "a2",
   "voix": "alimata",
   "texte": "Une lettre scellée…",
   "debut": 23.535,
   "fin": 24.563
  },
  {
   "id": "a3",
   "voix": "alimata",
   "texte": "qui s'ouvre à l'heure que tu choisis.",
   "debut": 24.643,
   "fin": 26.101
  },
  {
   "id": "a4",
   "voix": "alimata",
   "texte": "Et avant l'heure ?",
   "debut": 26.301,
   "fin": 27.123
  },
  {
   "id": "a5",
   "voix": "alimata",
   "texte": "Impossible de l'ouvrir. Même en insistant.",
   "debut": 27.203,
   "fin": 29.801
  },
  {
   "id": "a6",
   "voix": "alimata",
   "texte": "Tu l'écris…",
   "debut": 30.001,
   "fin": 30.693
  },
  {
   "id": "a7",
   "voix": "alimata",
   "texte": "ou la plume l'écrit avec toi, à partir de tes souvenirs.",
   "debut": 30.773,
   "fin": 33.409
  },
  {
   "id": "a8",
   "voix": "alimata",
   "texte": "La cire, le sceau, le papier, ta photo…",
   "debut": 33.609,
   "fin": 36.88
  },
  {
   "id": "a9",
   "voix": "alimata",
   "texte": "et une pluie d'étoiles à l'ouverture.",
   "debut": 36.96,
   "fin": 38.773
  },
  {
   "id": "a10",
   "voix": "alimata",
   "texte": "Pour la Saint-Valentin…",
   "debut": 38.973,
   "fin": 39.982
  },
  {
   "id": "a11",
   "voix": "alimata",
   "texte": "à minuit pile,",
   "debut": 40.062,
   "fin": 40.922
  },
  {
   "id": "a12",
   "voix": "alimata",
   "texte": "avant tout le monde.",
   "debut": 41.002,
   "fin": 41.6
  },
  {
   "id": "a13",
   "voix": "alimata",
   "texte": "Pour t'excuser…",
   "debut": 41.8,
   "fin": 42.641
  },
  {
   "id": "a14",
   "voix": "alimata",
   "texte": "sans qu'on te raccroche au nez.",
   "debut": 42.721,
   "fin": 44.385
  },
  {
   "id": "a15",
   "voix": "alimata",
   "texte": "Pour une demande…",
   "debut": 44.585,
   "fin": 45.37
  },
  {
   "id": "a16",
   "voix": "alimata",
   "texte": "quand la voix tremble.",
   "debut": 45.45,
   "fin": 46.384
  },
  {
   "id": "a17",
   "voix": "alimata",
   "texte": "Ou la soirée entre potes : l'heure, le lieu…",
   "debut": 46.584,
   "fin": 48.939
  },
  {
   "id": "a18",
   "voix": "alimata",
   "texte": "et qui ramène les boissons.",
   "debut": 49.019,
   "fin": 50.72
  },
  {
   "id": "a19",
   "voix": "alimata",
   "texte": "Ma lettre à…",
   "debut": 51.12,
   "fin": 52.074
  },
  {
   "id": "a20",
   "voix": "alimata",
   "texte": "Dès mille francs.",
   "debut": 52.154,
   "fin": 52.92
  },
  {
   "id": "a21",
   "voix": "alimata",
   "texte": "Tape un prénom :",
   "debut": 53.12,
   "fin": 53.811
  },
  {
   "id": "a22",
   "voix": "alimata",
   "texte": "ta lettre commence.",
   "debut": 53.891,
   "fin": 54.845
  }
 ],
