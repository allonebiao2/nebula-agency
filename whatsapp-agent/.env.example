# === LE STANDARD — variables d'environnement ===
# Copier en .env (jamais commité) ou poser ces variables sur l'hébergeur.
# Un suffixe permet de servir plusieurs maisons dans un même processus :
#   WA_META_TOKEN_BRAISE_DOR=...   l'emporte sur   WA_META_TOKEN=...

# --- Claude ---
ANTHROPIC_API_KEY=
WA_MODELE=claude-sonnet-5      # règle NEBULA : Sonnet pour tout texte client
WA_EFFORT=low                  # low | medium | high — « low » suffit et répond vite
WA_JETONS_MAX=4000

# --- Canal : Meta Cloud API (la production) ---
WA_CANAL=meta
WA_META_TOKEN=                 # jeton permanent de l'app Meta
WA_META_PHONE_ID=              # Phone Number ID du numéro du client
WA_META_VERIFY=                # mot de passe que VOUS choisissez, à recopier chez Meta
WA_META_SECRET=                # App Secret — sans lui le webhook refuse TOUT
WA_META_VERSION=v21.0

# --- Canal : Twilio (le pilote) ---
# WA_CANAL=twilio
WA_TWILIO_SID=
WA_TWILIO_TOKEN=
WA_TWILIO_FROM=                # ex. +14155238886 (bac à sable)

# --- Service ---
PORT=8020
WA_BASE=whatsapp-agent.db      # la base des conversations
